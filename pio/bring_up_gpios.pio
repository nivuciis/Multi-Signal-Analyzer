; @file bring_up_gpios.pio
;
; @brief The asm code to bring up the GPIO reading PIO program.
; @author João Matheus Nascimento Dias (joao.dias@edge.ufal.br)
; @version 0.1
; @date 12/01/2026
;
; @copyright Copyright (c) 2025

.program bring_up_gpios
.wrap_target
LOOP:
   in pins, 12
   in null, 4 ; 16 bits (12 from pins + 4 null)
   ;push block - Uncommented if not using autopush at SM setup
   jmp LOOP 
.wrap

% c-sdk {

%}